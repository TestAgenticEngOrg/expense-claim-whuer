title Expense Claim App

component expense-webapp as "Expense Webapp" web-application
component expense-api as "Expense API" service
component expense-assistant as "Expense Assistant Agent" ai-agent

component expense-db as "Expense Database" database
component expense-assistant-db as "Expense Assistant Memory" database

east user-auth as "Thunder Auth" identity-server

north -> expense-webapp

expense-webapp -> expense-api
expense-webapp -> expense-assistant
expense-webapp -> user-auth

expense-api -> user-auth
expense-api -> expense-db

expense-assistant -> user-auth
expense-assistant -> expense-assistant-db
